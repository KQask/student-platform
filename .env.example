# Local Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://student:student@localhost:5433/student_platform?schema=public"

# Auth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Optional: Google OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Integration toggles
# When false, services skip live fetches and serve seed data only (useful for CI / offline demo).
ASSIST_LIVE_FETCH="true"
FOOTHILL_LIVE_FETCH="true"

# ASSIST API base
ASSIST_API_BASE="https://prod.assistng.org"

# Foothill schedule + catalog
FOOTHILL_SCHEDULE_BASE="https://foothill.edu/schedule"
FOOTHILL_CATALOG_BASE="https://catalog.foothill.edu"
