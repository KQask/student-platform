// Student Platform — data model
// Designed for: Foothill (sending) → UC (receiving) transfer planning + thin social layer.
// All IDs are cuid(); all models carry createdAt/updatedAt.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & profile (+ Auth.js adapter tables)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  isPublic      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile        Profile?
  accounts       Account[]
  sessions       Session[]
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  sentRequests   Connection[]      @relation("ConnectionRequester")
  recvRequests   Connection[]      @relation("ConnectionAddressee")
  clubMemberships ClubMembership[]
  reviews        Review[]
  plans          AcademicPlan[]
  messages       Message[]
  threadParts    MessageThreadParticipant[]
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  schoolId        String?
  majorId         String?
  careerGoal      String?
  bio             String?
  interests       String[] @default([])
  skills          String[] @default([])
  extracurriculars String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school        School?  @relation("ProfileSchool", fields: [schoolId], references: [id])
  major         Major?   @relation(fields: [majorId], references: [id])
  transferGoals TransferGoal[]

  @@index([schoolId])
  @@index([majorId])
}

// Profile <-> School M2M for "transfer destination" goals
model TransferGoal {
  id        String  @id @default(cuid())
  profileId String
  schoolId  String
  majorId   String?  // optional — student may target a school without a fixed major
  priority  Int     @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id])
  major   Major?  @relation(fields: [majorId], references: [id])

  @@unique([profileId, schoolId, majorId])
  @@index([schoolId])
}

// Auth.js (NextAuth v5) Prisma adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Academic catalog
// ─────────────────────────────────────────────────────────────────────────────

enum SchoolType {
  CC
  UC
  CSU
  PRIVATE
  OTHER
}

model School {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  type        SchoolType
  assistInstitutionId Int?       // ASSIST.org institutionId, when known
  isPrimary   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  majors            Major[]
  courses           Course[]
  professors        Professor[]
  profiles          Profile[] @relation("ProfileSchool")
  transferGoals     TransferGoal[]
  clubs             Club[]
  reqsAsReceiving   RequirementSet[]   @relation("ReceivingSchool")
  agreementsSent     TransferAgreement[] @relation("Sending")
  agreementsReceived TransferAgreement[] @relation("Receiving")
}

model Major {
  id        String   @id @default(cuid())
  name      String
  code      String?
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profiles      Profile[]
  transferGoals TransferGoal[]
  requirementSets RequirementSet[]
  agreements    TransferAgreement[]

  @@unique([schoolId, name])
}

model Course {
  id          String   @id @default(cuid())
  code        String
  title       String
  units       Float    @default(0)
  description String?
  schoolId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections        Section[]
  planCourses     PlanCourse[]
  reqOptions      RequirementOption[]
  reviews         Review[]  @relation("CourseReviews")

  @@unique([schoolId, code])
  @@index([code])
}

model Professor {
  id          String   @id @default(cuid())
  name        String
  schoolId    String
  departments String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections    Section[]
  reviews     Review[]     @relation("ProfessorReviews")
  planCourses PlanCourse[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

enum Modality {
  IN_PERSON
  ONLINE
  HYBRID
  UNKNOWN
}

model Section {
  id          String   @id @default(cuid())
  courseId    String
  professorId String?
  term        String   // e.g. "Fall 2026"
  crn         String?  // section/CRN identifier (Foothill scheduler)
  days        String?  // e.g. "MWF"
  startTime   String?  // e.g. "10:00"
  endTime     String?  // e.g. "10:50"
  location    String?
  modality    Modality @default(UNKNOWN)
  capacity    Int?
  enrolled    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor Professor? @relation(fields: [professorId], references: [id])

  @@index([courseId, term])
  @@index([term])
}

// ─────────────────────────────────────────────────────────────────────────────
// Transfer requirements (sourced from ASSIST.org)
// ─────────────────────────────────────────────────────────────────────────────

enum RequirementSetType {
  CALGETC
  MAJOR_PREP
  GRADUATION
}

model RequirementSet {
  id               String              @id @default(cuid())
  name             String              // e.g. "UC Berkeley CS Major Prep 2025-26"
  receivingSchoolId String
  majorId          String?
  type             RequirementSetType
  academicYear     String              // e.g. "2025-2026"
  sourceUrl        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  receivingSchool School             @relation("ReceivingSchool", fields: [receivingSchoolId], references: [id], onDelete: Cascade)
  major           Major?             @relation(fields: [majorId], references: [id])
  groups          RequirementGroup[]

  @@index([receivingSchoolId, majorId])
}

model RequirementGroup {
  id               String   @id @default(cuid())
  requirementSetId String
  name             String   // e.g. "Calculus Series" or "Area 1A: English Composition"
  description      String?
  minCourses       Int      @default(1)
  minUnits         Float    @default(0)
  order            Int      @default(0)

  requirementSet RequirementSet      @relation(fields: [requirementSetId], references: [id], onDelete: Cascade)
  options        RequirementOption[]

  @@index([requirementSetId])
}

model RequirementOption {
  id                 String   @id @default(cuid())
  requirementGroupId String
  courseId           String
  // For ASSIST "series" requirements like CS 1A + CS 1B + CS 1C, options that share the
  // same `seriesKey` must all be completed together to satisfy the group.
  seriesKey          String?

  requirementGroup RequirementGroup @relation(fields: [requirementGroupId], references: [id], onDelete: Cascade)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([requirementGroupId, courseId])
  @@index([courseId])
}

// Audit trail of raw ASSIST payloads so we can re-parse without re-fetching.
model TransferAgreement {
  id                String   @id @default(cuid())
  sendingSchoolId   String
  receivingSchoolId String
  majorId           String?
  academicYear      String
  sourceUrl         String?
  rawJson           Json
  fetchedAt         DateTime @default(now())

  sendingSchool   School @relation("Sending",   fields: [sendingSchoolId],   references: [id], onDelete: Cascade)
  receivingSchool School @relation("Receiving", fields: [receivingSchoolId], references: [id], onDelete: Cascade)
  major           Major? @relation(fields: [majorId], references: [id])

  @@unique([sendingSchoolId, receivingSchoolId, majorId, academicYear])
}

// ─────────────────────────────────────────────────────────────────────────────
// Academic planner
// ─────────────────────────────────────────────────────────────────────────────

model AcademicPlan {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("My Plan")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms PlanTerm[]

  @@index([userId])
}

model PlanTerm {
  id              String   @id @default(cuid())
  academicPlanId  String
  term            String   // "Fall 2026"
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plan    AcademicPlan @relation(fields: [academicPlanId], references: [id], onDelete: Cascade)
  courses PlanCourse[]

  @@unique([academicPlanId, term])
}

enum PlanCourseStatus {
  PLANNED
  ENROLLED
  COMPLETED
  DROPPED
}

model PlanCourse {
  id          String           @id @default(cuid())
  planTermId  String
  courseId    String
  professorId String?
  status      PlanCourseStatus @default(PLANNED)
  grade       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  planTerm  PlanTerm   @relation(fields: [planTermId], references: [id], onDelete: Cascade)
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  professor Professor? @relation(fields: [professorId], references: [id], onDelete: SetNull)

  @@unique([planTermId, courseId])
  @@index([planTermId])
  @@index([courseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Social layer (thin MVP)
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id        String   @id @default(cuid())
  authorId  String
  body      String   @db.Text
  tags      String[] @default([])
  mediaUrls String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions Reaction[]

  @@index([postId])
}

enum ReactionType {
  LIKE
  SAVE
}

model Reaction {
  id        String       @id @default(cuid())
  type      ReactionType
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, commentId, type])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Club {
  id          String   @id @default(cuid())
  name        String
  schoolId    String
  description String?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  memberships ClubMembership[]

  @@index([schoolId])
}

model ClubMembership {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
}

enum ReviewTargetType {
  COURSE
  PROFESSOR
}

model Review {
  id         String           @id @default(cuid())
  authorId   String
  targetType ReviewTargetType
  courseId   String?
  professorId String?
  rating     Int              // 1..5
  body       String?          @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  course    Course?    @relation("CourseReviews",    fields: [courseId],    references: [id], onDelete: Cascade)
  professor Professor? @relation("ProfessorReviews", fields: [professorId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([professorId])
}

model MessageThread {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants MessageThreadParticipant[]
  messages     Message[]
}

model MessageThreadParticipant {
  id       String @id @default(cuid())
  threadId String
  userId   String

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}
